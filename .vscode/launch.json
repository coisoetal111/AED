{
    "version": "2.0.0",
    "configurations": [
        
        {
            "name": "VScode Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/healkristin",
            "args": [
                "${input:argFile}",
                "${input:argFile2}",
                "${input:argFile3}"
            ],
            "stopAtEntry": true,
            "cwd": "${workspaceRoot}/",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": false
                }
            ],
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ],
    "inputs": [
        {
            "id": "argFile",
            "type": "promptString",
            "description": "Input File",
            "default": ""
        },
        {
            "id": "argFile2",
            "type": "promptString",
            "description": "Input File2",
            "default": ""
        },
        {
            "id": "argFile3",
            "type": "promptString",
            "description": "Input File3",
            "default": ""
        }
    ],
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build active file",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-lm"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}